{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "src/types"]
}